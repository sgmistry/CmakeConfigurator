{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "description": "Debug build with symbols using Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_CALCULATOR_CLI": "ON",
        "ENABLE_UNIT_TESTING": "ON",
        "CALCULATOR_PRECISION": "HIGH"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "description": "Optimized release build using Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_CALCULATOR_CLI": "ON",
        "ENABLE_UNIT_TESTING": "OFF",
        "CALCULATOR_PRECISION": "HIGH"
      }
    },
    {
      "name": "make-debug",
      "displayName": "Unix Makefiles Debug",
      "description": "Debug build using Unix Makefiles",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_CALCULATOR_CLI": "ON",
        "ENABLE_UNIT_TESTING": "ON"
      }
    },
    {
      "name": "make-release",
      "displayName": "Unix Makefiles Release",
      "description": "Optimized build using Unix Makefiles",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_CALCULATOR_CLI": "ON",
        "ENABLE_UNIT_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-all-debug",
      "displayName": "Build All (Debug)",
      "configurePreset": "ninja-debug",
      "targets": "all"
    },
    {
      "name": "build-cli-debug",
      "displayName": "Build CLI Executable Only",
      "configurePreset": "ninja-debug",
      "targets": "calculator_cli"
    },
    {
      "name": "build-tests-debug",
      "displayName": "Build Tests Target",
      "configurePreset": "ninja-debug",
      "targets": "calc_tests"
    },
    {
      "name": "build-all-release",
      "displayName": "Build All (Release)",
      "configurePreset": "ninja-release",
      "targets": "all"
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "displayName": "Run All Tests (Debug)",
      "configurePreset": "ninja-debug"
    }
  ]
}

